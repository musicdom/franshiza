# Copy these names into the hosting provider's secret/environment settings.
# Do not put real credentials in Git or in client-side JavaScript.

UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_TOKEN
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Optional until MAX bot and destination chat are ready.
MAX_BOT_TOKEN=
MAX_ADMIN_CHAT_ID=
